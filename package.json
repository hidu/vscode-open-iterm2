{
  "name": "vscode-our-terminal",
  "displayName": "Our Terminal",
  "description": "Open external Terminal for vscode",
  "version": "0.0.1",
  "publisher": "hidu",
  "author": {
    "name": "hidu",
    "email": "duv123+vs@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hidu/vscode-our-terminal.git"
  },
  "homepage": "https://github.com/hidu/vscode-our-terminal/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/hidu/vscode-our-terminal/issues"
  },
  "icon": "res/icon.png",
  "keywords": [
    "external terminal"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/src/extension",
  "contributes": {
    "commands": [
      {
        "command": "extension.our-terminal.open",
        "title": "%command.openTerminal%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "extension.our-terminal.open",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "extension.our-terminal.open",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "extension.our-terminal.open"
        }
      ],
      "editor/title/context": [
        {
          "command": "extension.our-terminal.open"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "format": "prettier --write .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
